window.NGM_RU_DISEASES = [
["Абсцесс, нарыв","abscess","Абсцесс, нарыв, гнойник.\nОшибки:\nУсловия, которые вам приходится видеть в жизни, вызывают гнев и разочарование. Накопление гнева. Мысли о причиненном кем-то зле, об обидах, унижении, невнимании, пренебрежении и об отмщении. Возможно, стыд из-за страха и гнева. Отгораживание от проблемы, изоляция. Боязнь \"вскрыть нарыв\". Навязанное, чужеродное - чужая идея, мысль, с чем вы не согласны.\nДля уточнения ошибки в мышлении полезно проследить связь с местом на теле, в котором возник абсцесс."],
["Автомобильная болезнь, укачивает в движении","autom","Автомобильная болезнь. Укачивание при движении.\nВ мозге разошлись показания разных \"датчиков\", например, глаза говорят одно, мозжечок (ориентация в пространстве) другое. Анализ ситуации нарушен, контроль не возможен. Мозг запускает режим \"чрезвычайных ситуаций\" - вброс адреналина, опорожнение кишечника и т.д.\nОшибки:\nОщущение, что потерян контроль над собой. Страх, что не контролируете ситуацию. Страх, рабство, зависимость. Чувство, что попались в ловушку, загнаны в тупик."],
["Агорафобия","agora","Агорафобия\nБоязнь (дискомфорт) открытых пространств и общественных мест. Избегающее поведение.\nОшибки:\nВозможно, сильная зависимость от матери. Страх смерти и сумасшествия. Плохо контролируемая сверхчувствительность.\nНовая мысль:\nМир вокруг безопасен и дружелюбен. Я в порядке. Я в безопасности. Теперь я сам принимаю решения и сам отвечаю за свою жизнь."],
["Аденоиды","adeno","Аденоиды.\nПроблемы - разрастание лимфоидной ткани, отвечающей за защиту организма от повреждения \"болезнетворными элементами\".\nОшибки:\nГиперопека \"от всех \"опасностей\", могут обидеть, задеть, заразить. Тревожное состояние мамы. Состояние \"небезопасности\", \"беззащитности\". Детские \"слезы печали\". Семейные трения, споры. Родители не понимают ребёнка, не выслушивают его тревог. Ребенок может чувствовать себя нелюбимым, лишним, нежеланным. Скрывает свои мысли и эмоции из страха оказаться непонятым."],
["Адисона болезнь","adison","Адисона болезнь. Надпочечная недостаточность.\nОшибки:\nСильная нехватка эмоциональной подпитки. Гнев на себя.\nПораженчество. Претит заботиться о себе. Беспокойство, тревога."],
["Альцгеймера болезнь","alcge","Альцгеймера болезнь.\nТакже Деменция. Старость. Дряхлость. Слабоумие.\nОшибки:\nОбщественное мнение. Устаревшие мысли. Боязнь быть собой. Способ убежать от реальности. Жил только для детей, только для кого-то, теперь одинок и забыт. Страдание от одиночества и разлуки. Больше незачем воспринимать новую информацию.\nРеализация мести за свое долготерпение и молчание. Неспособность посмотреть в лицо жизни такой, какая она есть. Отказ взаимодействовать с миром таким, какой он есть. Безнадежность и беспомощность.\nДети забрали к себе (напр. из деревни в город), чувствует себя потерянно, некуда приложить руки, все не так, как было. Все заняты своими делами, стал обузой.\nГнев. Желание покинуть эту планету. Абсолютизация потенциала своего мозга.\nМаксималистское желание получать.\nВозвращение к так называемой безопасности детства. Требование заботы и внимания. Одна из форм контроля над окружающими. Бегство."],
["Алкоголизм","alcog","Алкоголизм.\nОшибки:\nОтсутствие смысла. Чувство бесполезности, пустоты, вины. Душевная боль из-за отсутствия чувства собственного достоинства. Отрицание себя, собственной ценности. Самобичевание. \"Меня не любят\". \"Любви нет\".\nВыход из-под давления и контроля. Нежелание быть печальным. У мужчины - чувство вины перед женщиной за свою ненадежность.\nЕсли человек в состоянии контролировать прием алкоголя, например, может остановиться, потому что \"утром на работу\" - это не считается алкоголизмом."],
["Аллергия","allerg","Аллергия.\nОбщий принцип возникновения:\nНаличие аллергена в тот момент, когда было плохо (сильные эмоции). Мозг связал \"плохо\" с \"этим\" и записал \"мне сейчас плохо и есть \"вот это\".\nОшибки:\nРаздражение. Отрицание собственной силы. Не можете терпеть и не можете изменить. Кого вы не переносите? (когда-то аллерген стал для вас опасным)\nНежелание страдать молча. Страх \"меня не любят\". Хочу и боюсь. Стремлюсь и убегаю. Расставание и разлука, которую трудно пережить.\nАллергия у детей.\nНенависть и гнев родителей по отношению к чему-либо; страх ребенка «меня не любят».\nНа рыбные продукты.\nПротест против самопожертвования родителей.\nНа собачью шерсть. На животных.\nПротест против рабства. Возможно, животные (коты, собаки, крысы) напоминают кого-то, раздражающего человека.\nНа коже.\nЗаглушаемая или подавляемая жалость у матери, печаль.\nСенная лихорадка.\nЭмоциональный перебор. Убеждение, что вас преследуют. Чувство вины. Иногда боязнь календаря (сезонные обострения)."],
["Аменорея","ameno","Менструация.\nАменорея. Дисменорея. Расстройство, длительное отсутствие месячных. Менструальные проблемы. ПМС.\nОшибки:\nНеприятие своего женского начала. Нежелание быть женщиной. Неприязнь к самой себе. Отказ от женственности. Позволяете царить беспорядку. Усиливаете внешнее воздействие. Гнев, обращённый на себя. Ненависть к женскому телу или женщинам. Чувство вины, страх. Убеждённость, что всё, связанное с гениталиями, греховно или нечисто.\nНаличие сексуальных проблем, спрятанных глубоко внутри, нежелание признать существование таких проблем. Перекос во взаимоотношениях с родителями обоего пола. Родительское влияние на сексуальность."],
["Амнезия","amnes","Амнезия. Полное или частичное отсутствие памяти.\nОшибки:\nСтрах. Бегство от жизни. Неспособность постоять за себя.\nНовая мысль:\nЖить безопасно. Со мной всегда мой ум, смелость и высокая оценка себя."],
["Ангина","angina","Ангина. Тонзиллит.\nГорло - орган самовыражения.\n(см. также \"Гланды\")\nОшибки:\nУщемление самовыражения. Сильное убеждение, что вы не можете поднять голос в защиту своих взглядов и попросить удовлетворить свои потребности. Чувство невыносимого унижения. Вы сдерживаетесь от грубых слов. Чувствуете неспособность выразить себя. Гордыня. Желание и невозможность что-то (кого-то) удержать, сохранить.\nВ грудном возрасте могут проявляться проблемы взаимоотношений между родителями. У детей часто нехватка любви и заботы со стороны мамы. Часто чрезмерная опека со стороны мамы."],
["Анемия","anemia","Анемия. Малокровие. Недостаток гемоглобина в крови.\nОшибки:\nДефицит радости. Страх перед жизнью. Чувство, что недостаточно хороши для окружающего мира. Трудности с принятием себя, нахождением решений, преодолением трудностей. Потеря контакта со своими желаниями и потребностями. Вера в собственную ущербность. Я не справляюсь с тем, с чем сталкиваюсь. Непринятие своего рода или одного из его членов, конфликт с родом. Недостаток любви в семье. Жить не своей жизнью, заниматься не своим делом."],
["Аневризма","aneur","Аневризма.\nОшибки:\nНакоплено слишком много отрицательных эмоций. Лишен радости прежних отношений. Пережит или переживается мощный эмоциональный \"разрыв\". Принято решение о разрыве, так больше не в состоянии сдерживать и переживать эти сильные эмоции. Подсознательное обвинение себя в этом разрыве."],
["Аноргазмия","frigd","Фригидность.\nОшибки:\nСтрах. Неприятие наслаждения. Уверенность, что секс — это плохо. Бесчувственные партнёры. Боязнь отца."],
["Анорексия","anorex","Анорексия\nОшибки:\nСтрах перед принуждением. Ненависть к себе. Отрицание себя. Чувство вины, беспомощность, подавленность жизнью, отрицательная зацикленность на своей внешности. Жалость к себе из-за неспособности жить полноценной жизнью.\nБессознательный протест и восстание против авторитета матери в поисках автономности. Желание быть собой, принимать решения самостоятельно. Больше отказаться не от чего."],
["Анурия","anuria","Анурия. Отсутствие поступления мочи в мочевой пузырь.\nОшибки:\nНежелание дать волю горечи от несбывшихся желаний."],
["Анус","anus","Анус.\nОлицетворяет расставание с прошлым, ненужным.\nОшибки:\nПроблемы: Неумение избавляться от накопившихся проблем, обид и эмоций. Выработанный навык сдерживания себя в жизненных ситуациях.\nАбсцесс: Злость на то, от чего никак не избавитесь.\nБоль: Чувство вины. Желание наказания.\nГеморрой. Варикозное расширение вен ануса и прямой кишки. Тромбоз, воспаление геморроидальных узлов. Принуждение себя, насильственное ускорение процессов. Боязнь не уложиться в отведённое время. \"Рвать жопу\". Неспособность противоречить другим. Неспособность отказаться. Страх запретной черты, предела. Желание избавиться от отталкивающей ситуации. Ощущение материального неблагополучия. Повышенные требования к себе. Неспособность принимать решения. Страх перед расставанием. Боязнь отпустить процесс. Гнев, обиды, связанные с прошлым. Возможно, сложные отношения с отцом. Тягостное чувство.\nГеморрой у детей: Идентификация в группе. Кто я относительно своей семьи, своего отца, своего пола, своего общества. Невозможность занять свое место. Чувство, что \"сидишь между двух стульев\". Нежелание возвращаться домой, в кровную семью. Страх быть оставленным матерью.\nКровотечение: Конфликт в связи со смертью матери. Неспособность найти себя в жизни без матери, постоянно нуждаться в ее мнении.\nЗуд: Чувство вины перед прошлым. Угрызения совести, раскаяние. Искушение чувством долга.\nКровотечение: Гнев и разочарование.\nСвищ, фистула: Неполное освобождение от мусора, ненужного хлама. Продолжаете упорно цепляться за хлам прошлого.\nТрещины: Собственное немилосердное принуждение."],
["Апатия","apatia","Апатия. Безразличие, безучастие, отсутствие стремления, отсутствие положительного и отрицательного отношения, отсутствие внешних эмоциональных проявлений.\nОшибки:\nСопротивление чувствам. Подавление эмоций. Заглушение своего \"Я\". Страх.\nНовая мысль:\nЧувствовать — безопасно. Я открываюсь, иду навстречу жизни. Я стремлюсь пройти через испытания жизни. Я люблю жить."],
["Апоплексия","insult","Апоплексия. Инсульт.\nОшибки:\nБегство от семьи, от себя, от жизни. Сильные эмоции на фоне недоверия, неверия (близким, жизни, правительству, производителям, продавцам, ситуации). Жажда мести. Страх перед злым недовольством окружающих."],
["Аппендицит","append","Аппендицит.\nОшибки:\nСостояние физического тупика, возникающее как следствие духовного тупика. Унижение от тупиковой ситуации. Неумение выйти из тупиковой ситуации. Чувство безысходности. Ситуация вызывает гнев и страх. Страх перед жизнью. Блокирование всего хорошего. Необоснованное обвинение родителей. Отрицание, подавление чего-то в себе или в другом. Ждать и терпеть."],
["Аппетит","appet","Аппетит.\nОшибки:\nЧрезмерный аппетит: Стремление компенсировать нехватку жизненной энергии. Страх. Потребность в защите. Осуждение своих эмоций. Злоба против тех, кто не принимает вашу доброту.\nПотеря аппетита: Страх. Защита себя. Недоверие к жизни. Отрицание личной жизни. Ненависть к себе и отрицание себя."],
["Артерии","arter",""],
["Артрит","artrit","Артрит. Воспаление суставов. Подагра.\nОшибки:\nСлишком строг к себе и другим людям, не прощает недостатки. НАДО. Все должно быть ПРАВИЛЬНО. Нельзя остановиться или расслабиться, желание добиться признания. Неумение выразить свои желания и потребности. Разочарование, критицизм, горечь, обида, ГНЕВ. Накопление парализующих эмоций. Кажущаяся покорность. Чувство, что не любимы. \"На меня взваливают слишком много\". Окружающие не оправдывают ожиданий. Желание отомстить и бессилие что-либо сделать. Давление внутренней критики. Потеря властных позиций в семье или на работе (выход на пенсию, дети выросли, уехали). Недостаточная гибкость и упрямство по отношению к будущему. Нежелание расставаться с властью, контролем. Потребность в доминировании. Отсутствие терпения.\nПри артрите пальцев рук. Желание наказывать. Обвинение, порицание, вина. Чувство, что вас обманули, что вы сделались жертвой обмана. Перекошенное отношение к тому, что делает руками.\nПодагра. Самообесценивание ➕ бегство.\nНе справлюсь, не смогу, не получится. ➕ Не на своем месте. Никто не поможет. Один, брошен, в опасности.\nПри подагре больших пальцев ног. Человек хочет властвовать, но не дает себе такого права. Властность не заметна, потому что проявляется окольными путями. Притворство.\nРевматоидный артрит. Воспалительное заболевание соединительной ткани с преимущественным поражением мелких суставов.\nКрайне критическое отношение к проявлению силы, к авторитету. Чувство, что на вас взваливают слишком много, обременены, обмануты."],
["Астигматизм","astigm","Астигматизм. Нарушение сферической формы роговицы глаза.\nОшибки:\nНеприятие собственного \"я\". Боязнь увидеть себя в истинном свете. Я беспокоюсь, волнуюсь, тревожусь. \"Перекос\" во взгляде, \"все вижу по-своему\". Убеждение, что своя картина мира объективная, а остальные ошибаются. Другие точки зрения не рассматриваются. Противоречия между внутренней и общественной жизнью человека. Внутренний конфликт от разности своих взглядов и взглядов окружающих. Трудности с принятием изменений, инициируемых другими, навязываемых другими."],
["Астма","astma","Астма.\nОшибки:\nУдушающая, подавляющая любовь. Неспособность дышать для собственного блага. Чувство подавленности. Сдерживание желания плакать. Подавленный страх. Боязнь плохого отношения к себе. Отсутствие смелости жить полноценной жизнью. Желание взять как можно больше. Желание казаться сильнее, чем есть на самом деле, и этим вызвать любовь к себе. Стеснительность в проявлении любви. Законное оправдание того, что не так силен, как хотелось бы. Берет больше, чем следует, и отдает с большим трудом. Доминирование над близкими с помощью болезни.\nВ раннем возрасте. Боязнь жизни. Нежелание быть здесь. Подавленные чувства любви."],
["Бедро","bedro","Бёдра.\nУстойчивая опора для тела. Несут на себе тело, сохраняя совершенное равновесие. Большая вера в движение вперед.\nОшибки:\nПроблемы и заболевания бедер. Боязнь движения вперёд. Отсутствие целей. Проблемы хозяйственной и материальной жизни.\nТазобедренный сустав. Годами подсознательное неприятие своей \"новой\" жизни, изменившейся роли, настоящего. Ожидание \"другого\", следующего этапа. Зависание в \"светлом\" прошлом или будущем, вне настоящего."],
["Бесплодие","bespl","Бесплодие.\nОшибки:\nСтрах и сопротивление жизненному процессу или отсутствие потребности в приобретении родительского опыта. Стресс во взаимоотношениях с матерью. Подчинение матери в выборе подруг, мужчины. Страх проблем, связанных с ребенком, пересиливает желание (страх тяжелых родов, изменений в фигуре, хлопоты). Непродуктивность, отсутствие результатов в какой-то сфере деятельности.\nИногда - невозможность почувствовать себя женщиной без ребенка.\nВозможны глубинные причины семейной истории:\n- Очень глубокая и сильная травма в истории женщин семьи. Например, изнасилование.\n- Брошенные дети, родители-одиночки в семейной истории.\n- Уход партнера во время беременности в семейной истории.\n- Смерть женщины в родах в истории семьи.\n- Тяжесть выживания (нечем кормить) и воспитания детей.\n- Другие сложности с беременностью, родами, материнством в роду.\nМужское бесплодие. Небезопасный опыт, драмы, несчастные случаи, голод и пр. в генеалогии. Страхи о здоровье и наследственности ребенка. Страх за проблемы материального обеспечения ребенка. Ощущение \"не главного\" мужчины в семье. Переживание реальной или воображаемой опасности (мошонка \"поджимается\")."],
["Беспокойство","bespo","Беспокойство.\nОшибки:\nНедоверие к тому, как течет и развивается жизнь. Постоянный анализ своего и чужого прошлого. Размышления о маловероятных событиях. Ожидание неясной, непредсказуемой опасности.\nНовая мысль:\nЯ в безопасности. Я доверяю миру, людям, своей интуиции. Я люблю себя и одобряю свои поступки и мысли."],
["Бессонница","besson","Бессонница.\nОшибки:\nСтрах. Недоверие к жизненному процессу. Чувство вины. Чрезмерная эмоциональность и беспокойство. Организм слишком долго находится в стрессе, что-то идет не так, как положено. Одиночество и беззащитность. Неуверенность в жизни. Неспособность завершить то, что должен. \"Бесполезен\", \"все испортил\". Не выраженный гнев, не высказанная обида, постоянный внутренний диалог. Продолжение поиска решения проблемы (длительный перегруз по работе). Жизненный конфликт важнее, чем спать."],
["Бешенство","beshen","Бешенство. Водобоязнь.\nОшибки:\nГнев. Вера в то, что насилие — единственное решение.\nНовая мысль:\nМеня окружают мир и покой. Я испытываю мир и покой в душе."],
["Боль","bol","Боль. Индикатор конфликта, нарушений, гибели клеток. Друг. Советчик. Информатор.\nОшибки:\nВИНА. Вина всегда ищет наказания.\nСтремление к любви. Желание объятий.\nБолячки. Раны. Язвы. Невысвобожденный наружу гнев.\nВнезапная боль. Сообщает человеку, что он сам винит себя в чем-то, что сделал или не сделал, или в том, что имел какие-то намерения. Сообщает об ошибочных мыслях по причине необъективной оценки ситуации, о конфликте с собой, с миром, с людьми.\nБоли продолжительные, тупые. Тупая злоба, чувство беспомощности по поводу реализации своей злобы. Жажда любви. Жажда, чтобы вами владели.\nГоловная боль.👇 Спазм. Страх. Страх \"меня не любят\". Считаете себя неполноценными. Самокритика. Предъявление повышенных требований к себе. Неправильное выполнение телом миссии души (выбор деятельности в жизни). Переживание о событиях, которые еще не наступили, преждевременная суета, страх и беспокойство. Интеллект в сочетании с подавленными эмоциями. Отсутствует навык адекватно выражать свои эмоции, умение их проговаривать и делиться. Слишком много думать, не выражая мыслей и эмоций из страха стать объектом чей-то критики. Мысленная \"жвачка\". Сложность в примирении с собой из-за совершения необдуманных поступков. Боль блокирует мышление и \"защищает\" от \"головняка\".\nЛоб. Сфера мышления. Перегрузка от желания быстро и идеально решить много задач. Перенапряжение в попытке понять все.\nВиски. Страх, что скажут, или подумают. Ненависть к принуждению. Сопротивление ходу жизни. Сексуальные страхи.\nМигрень. Неумение искать причину недомогания. Недооценка себя. Нет права быть самим собой. Самокритика. Страх. Чувство вины из-за попытки выступать против значимых для себя людей. Отвращение, когда ведут. Неправильный выбор пути, профессии под влиянием мнения близких, социального давления (может привести к опухоли мозга). Давно не решаемый вопрос, прочно засевший в голове. Сопротивление течению жизни. Печаль и страх «меня не любят». Проявление зависимости для того, \"чтобы любили\". Сексуальные трудности и страхи (обычно могут быть облегчены мастурбацией) из-за невыражения себя, жизни \"в тени\" другого человека, \"задвигания\".\nБолит за глазами. Невыплаканные слезы, эмоции, грусть.\nЗатылок и шея. Обвинения других в своих собственных промахах.\nУ детей. Неумение разрешать разногласия между родителями. Уничтожение родителями детского мира чувств и мыслей. Постоянные обиды.\nМышечная боль. Сопротивление новому опыту. Мышцы символизируют способность к движению по жизни. \"Я не могу и не хочу ничего делать\", \"слишком слабый\", \"слишком страдаю\". Неуверенность в собственных силах, страх, боль идти вперед, по своему пути, достигать поставленные цели. Слабость и ранимость. Не хватает мотивации и воли для реализации своих желаний.\nБоль при половом акте. Подавление чувств и эмоций в связи с неудовлетворенностью. Партнер не устраивает. Есть другой партнер. Глубокая обида на партнера, месть через отказ в близости - на бессознательном уровне. Жертвенность \"во имя любви\", манипуляция с помощью жертвенности - на бессознательном уровне. Низкий уровень любви к себе. Страх потерять партнера и внутренний запрет, табу на спокойное общение в области сексуальности. \"Моральный запрет\" со стороны родителей на получение удовольствия от сексуальных контактов, на проявление своей женственности.\nБоль в верхней части спины. От шеи до талии. Сфера взаимоотношений. Отсутствие моральной поддержки. Чувство, что тебя не любят. Сдерживание чувства любви. Блокировка любви к себе, к людям, к миру. Слишком много делаю (обида). Слишком мало делаю (вина). Мои действия не вознаграждаются, не возвращаются благодарностью. Ответственность за чужие чувства. Опора для всего человечества.\nБоль от газов в кишечнике (метеоризм). Сфера воли, власти, давления. Зажатость. Страх. Нереализованные идеи."],
["Бородавки","borod","Бородавки.\nОшибки:\nМелкое выражение ненависти. Вера в собственное уродство.\nНа подошве. Гнев по поводу самих основ вашего понимания. Будущее разочаровывает вас всё сильнее и сильнее."],
["Бронхит","bronhit","Бронхит.\nОшибки:\nПроблемы, нервозная атмосфера в семье. Споры, крики и разногласия. Редкое затишье. Иногда кипение внутри. Подавленное раздражение. Уныние, невозможность открытого противостояния. Желание разорвать отношения с кем-то в семье и невозможность из-за чувства вины. Борьба с трудной и несправедливой жизнью. Чувство вины и выплёскивание его в виде обвинения на других. Неразрешаемый и подавляемый конфликт (родственники, родители, внешние факторы) несущий угрозу привычному существованию на своей территории. \"Где мое место, если тут все ваше\"? Конфликт не переходит на уровень действия для разрешения ситуации."],
["Булимия","bulim","Булимия. Обостренное чувство голода.\nОшибки:\nСтрах и безнадёжность. Лихорадочное переполнение и избавление от чувства ненависти к себе. Разрыв между \"фасадом\", маской и внутренним отношением к себе. Желание завладеть иллюзорным будущим и отвращение к нему. Желание жить как можно лучше и нежелание жить той жизнью, которая есть на данный момент. Превосходный фасад скрывает низкую самооценку, неуверенность в себе, довлеющие социальные шаблоны, мучительное ощущение своего несоответствия «идеалу». Попытка придать себе \"больший вес\" на уровне тела - за счет еды. Страх быть покинутым. Поскольку пища - символ женского начала, корни проблемы в нарушении отношений с матерью. Желание оторваться от матери, но невозможность это сделать. Ненависть к матери. Впадение в другую крайность - нуждаться в постоянном присутствии матери. Слишком много матери в жизни."],
["Бурсит","bursit","Бурсит. Воспаление синовиальной сумки - мешочка между сухожилием и костью (в локтях, плечах, коленях).\nОшибки:\nСимволизирует гнев. Накопление гнева, который нельзя проявлять и который стремится прорваться наружу. Желание ударить кого-либо. Усвоенная роль жертвы/тирана. Жалость к себе на фоне подавляемых вспышек агрессии, в стремлении наказать за \"несправедливое отношение/поступок\". Стремление к совершенству даже в мелочах. Очень много усвоенных социальных шаблонов.\nБурсит большого пальца стопы. Отсутствие радости при взгляде не жизнь."],
["Вагинит","vaginit","Вагинит. Воспаление слизистой оболочки влагалища.\nОшибки:\nЗлость на партнёра. Чувство вины на сексуальной почве. Наказание себя."],
["Варикоз","varicos","Варикозное расширение вен.\nОшибки:\nПребывание в ненавистной вам ситуации. Неодобрение. Чувство перегруженности и задавленности работой, отсутствие радости от работы, нелюбимая работа. Неправильно выбранный Путь, специальность, работа. Отвернулся от Пути, не реализуется в своей предрасположенности, предназначении. Упадок духа, обескураженность. Желание иметь больше свободы и свободного времени без понимания, что для этого нужно делать. Из раза в раз поддается искушению. Непосильные задачи и проблемы. Преувеличение серьезности проблем. Многое в жизни определяется словом \"надо\". Тихий голос, заставляющий работать без устали. Чувство вины за отдых и расслабление.\nЧто происходит дома? Не хочу возвращаться домой. Кто-нибудь когда-нибудь будет меня любить?"],
["Венерические болезни","vener","Венерические болезни.\nОшибки:\nЧувство вины на сексуальной почве (характерно для мужчин - не то, не так, не с той). Потребность в наказании. Ложная стыдливость, проявляемая в сексуальной сфере. Уверенность, что гениталии греховны или нечисты. Одна часть личности стремится к сексуальным отношениям, а другая хочет этому помешать. Боязнь попасть в зависимость, под влияние в отношениях. Сомнение в правильности выбора сексуального партнера. Оскорбление, плохое обращение с другими людьми. Ослабление иммунитета страхом о незапланированной беременности или инфекции. Отсутствие четкого выбора партнера в попытке избежать нежелательных сексуальных отношений."],
["Вес","ves","Вес.\nБиологический смысл: Тело решает задачу увеличения заметности, важности, значимости, отвоевывания пространства наращиванием объемов.\nОшибки:\nИзбыточный. Причиняющий реальный дискомфорт.\nСтрах. Потребность в защите. Реакция подсознания на неочевидную опасность. Бегство от чувств. Получаю слишком много внимания, нужно стать некрасивой, чтобы точно на меня никто даже не смотрел. Отсутствие чувства безопасности, отрицание себя. Снаружи опасно, нужно срочно нарастить щит и подушку. Поиск самореализации. Меня не замечают, нужно стать весомее и занимать больше пространства. Одиночество среди людей. Желание быть чрезмерно честным и высказывать все плохое, и в то же время страх высказать это плохое, чтобы самому не оказаться плохим в глазах окружающих. Все женщины в моем роду в теле, я чувствую себя виноватой, если я буду одна стройная и не как все. Запрет себе иметь то, что особенно хочется иметь. Стыдно быть собой, я лучше замру и буду копить ресурсы.\nХудоба.\nБыть не заметным. Избегание конфликтов путем \"незаметности\". Неумение принимать дары жизни, мира.\nИзбыточный у детей.\nНарушение границ ребенка со стороны родителей. Несоответствующее возрасту отношение, нежелание замечать, что ребенок вырос. Внутренний конфликт ограничения самостоятельности: \"хочу, но не могу\". Я хороший, послушный, но хочу изучать самостоятельную жизнь.\nОбмен веществ.\nДисбаланс между отдаванием и получением."],
["Ветрянка","vetrn","Ветрянка. Ветряная оспа. Герпесвирус (тип 1). Один из самых распространенных вирусов в организме. Активизируется в моменты \"проседания\" иммунитета.\nОшибки:\nТомительное ожидание события. Страх и напряжение. Повышенная чувствительность.\nНовая мысль:\nЯ доверяюсь естественному процессу жизни, отсюда моя расслабленность и миролюбие. Всё в моём мире идёт ровно."],
["Вирус. Инфекция","virus","Вирус. Вирусные, заразные заболевания. Инфекция.\nОшибки:\nПоддался какой-то мыслеформе, идее, которую принял или создал сам и которая мешает быть самим собой. Разделение убеждений, принятие чужих убеждений, как своих. Пессимизм. Болезненная реакция на неприятные мысли, слова и поступки других людей. Обвинение себя. Отсутствие в жизни радости. Раздражение. Гнев. Досада. Горечь. Обида. Злоба. Ненависть. Страх перед \"агрессией\". Уязвимость, слабость и хрупкость в надежде добиться этим внимания или любви.\nДети часто подвержены инфекциям из-за мобильности и слабости своего образа \"Я\", чувствуют себя одиноко в семье."],
["Витилиго","vitil","Витилиго. Исчезновение пигментации кожи. Белые пятна на коже. Возникает преимущественно в подростковом возрасте.\nОшибки:\n\"Белая ворона\". Чувство могучей уникальности. \"Божественная печать\". Чувство полной отчуждённости от всего. Вы не в своём кругу. Не связаны ни с чем. Ощущение, что находитесь вне вещей. Не входите ни в одну из групп."],
["Возрастные проблемы","agepr","Возрастные проблемы.\nОшибки:\nВера в социум. Старое мышление. Опасение быть чьим-то я. Отрицание настоящего момента."],
["Волдыри","voldr","Волдыри. Водяные пузыри.\nОшибки:\nСопротивление. Отсутствие эмоциональной защиты.\nНовая мысль:\nЯ мягко и спокойно теку вместе с жизнью и переживаю любой новый опыт. Все идет прекрасно."],
["Волосы","volos","Волосы. Символ жизненной силы и энергии, их состояние иллюстрирует уровень вашего субъективного ощущения безопасности мира.\nОшибки:\nПроблемы с волосами. Подавленные страх и напряжение. Сильный стресс, шок. Сильное ощущение беспомощности и отчаяния. Жизнь на адреналине, желаемое не совпадает с действительным. Попытка манипулировать событиями и контролировать их. Невозможность расслабиться, отпустить контроль. Страх проявить страх. Чрезмерное возбуждение проблемами и беспокойством, связанными с  физическим миром. Проблемы с доверием. Недостаточная вера в существование энергии Высшего разума, Вселенной. Неверие, уменьшающее жизненную энергию. Материальное берет верх над духовным. Неспособность справиться с разочарованием, желание \"рвать на себе волосы\".\nВыпадение волос. Беспомощность и отчаяние от потери или страха потерять. Иногда, вина за свою или чужую потерю. Сильное беспокойство о материальной стороне жизни. Контроль, отсутствие ощущения безопасности, доверия миру. Страх чужого мнения. Потребность одобрения со стороны значимых людей. Реакция на непонимание, отсутствие поддержки.\nСедые волосы. Стресс. Вера в давление и напряжение. Переутомление. В чем-то - неприятие себя.\nЛысина. Облысение. Страх. Напряжение. Стараетесь контролировать все вокруг. Не доверяете процессу жизни.\nВолосатость. Гнев, который прикрыт. Одеяло, которое обычно используется, это страх. Желание обвинять. Часто присутствует нежелание подпитывать себя."],
["Волчанка","volch","Волчанка красная. Системная красная волчанка. Болезнь Либмана-Сакса.\nОшибки:\nОпускаются руки. Лучше умереть, чем постоять за себя. Гнев и наказание."],
["Воспаление","vosp","Воспаление.\nОшибки:\nСтрах. Ярость. Воспалённое сознание. Условия, которые вам приходится видеть в жизни, вызывают гнев и разочарование. Внутренний конфликт между \"делать правильно\" и делать \"хочется\".\nНовая мысль:\nМои мысли тихие, спокойные, сконцентрированные. Я разрешаю свои конфликты, примиряю свои идеи, чувства, убеждения, желания. Я благодарю свое тело. Я люблю и одобряю себя.\nДля более объемного понимания сделайте запрос про место, где происходит воспаление."],
["Вросший ноготь (стопа)","vrosn","Вросший ноготь пальца стопы.\nОшибки:\nБеспокойство и чувство вины по поводу вашего права двигаться вперёд. Самоагрессия. Защита от самого себя. Усиление защиты на внешнем уровне.\nНовая мысль:\nВыбирать направление моего движения по жизни — моё священное право. Я — в безопасности, я — на свободе."],
["Вульва","vulva","Вульва. Наружные женские половые органы.\nСимвол уязвимости, ранимости.\nНовая мысль:\nБыть ранимой — безопасно. Я люблю и доверяю этому миру. Я притягиваю к себе только хорошее."],
["Вывих","vvih","Вывих.\nОшибки:\nВыход на пределы своих возможностей. Гнев из-за того, что не можете сказать \"нет\". Позволение другим манипулировать собой, уводить себя не в ту сторону, в которую хочется идти (ноги), или делать что-то, чего не хочется делать (руки). Тело говорит другим \"нет\" вместо вас. Страх нарушить правила. Вывих - удобный способ остановиться. Втискивание мира в узкие рамки своих правил."],
["Выкидыш","vkdsh","Выкидыш. Самопроизвольный аборт.\nОшибки:\nСтрах. Страх перед будущим. «Не сейчас — после». Ошибочный выбор момента. Стыд из-за беременности.\nНовая мысль:\nБожественное провидение заботится о том, что происходит со мной в жизни. Я люблю и ценю себя."],
["Гайморит","gaimr","Гайморит. Воспаление пазух.\nОшибки:\nЖелание скрыть обиду. Хроническая скрытая привычная не выражаемая жалость к себе. Раздражение по отношению к какому-то человеку, к кому-то близкому. Нерешенная проблема рядом, \"под носом\". \"Все достало!\" Колебания в принятии решения. Как поступить? Страх \"не учуять\" опасность. Ситуация \"с душком\", \"дурно попахивает\".\nХроническая форма - нерешенные старые обиды, злость, острые переживания."],
["Гангрена","gangr","Гангрена.\nОшибки:\nМентальная болезнь. Радостные чувства тонут в ядовитых мыслях. Унижение, вина. Неспособность выкарабкаться из экономических проблем.\nНовая мысль:\nСейчас я выбираю мысли, полные гармонии и любви. Я позволяю радости свободно протекать через меня."],
["Гастрит","gastr","Гастрит.\nОшибки:\nДлительная неуверенность, неопределенность. Чувство обречённости, рока. Накопленное невыраженное раздражение. Неприятие, отторжение происходящего. Принуждение себя. Желание быть хорошим, скромным, работящим, при этом проглатывая горечь разочарования. Страх \"меня не любят, не ценят, не справедливы ко мне\". Пассивность. Состояние \"жертвы\". Не можете договориться."],
["Гемофилия","gemo","Гемофилия. Нарушение процесса свертываемости крови.\nОшибки:\nОбожествление мести. Большая игра.\nНовая мысль:\nВо мне мир и покой.  Я позволяю вещам происходить естественным порядком."],
["Гениталии","genit","Гениталии.\nСимволизируют мужские или женские принципы.\nОшибки:\nПроблемы, болезни. Беспокойство, что недостаточно хорош(а). Самоедство, самобичевание. Боязнь оказаться не на высоте."],
["Гентингтона болезнь","gentn","Болезнь Гентингтона. Хорея Гентингтона.\nОшибки:\nНегодование, возмущение, что не можете изменить других. Чувство безнадежности.\nНовая мысль:\nЯ принимаю жизнь и людей такими, какие они есть. Все идет так, как надо."],
["Гепатит","gepat","Гепатит. Желтуха.\nОшибки:\nСопротивление переменам. Страх, гнев, ненависть. Печень — вместилище гнева и ярости. Игнорирование тем, связанных с мировоззрением, религией, духовных ценностей. Завышенные \"идеалы\", судорожная борьба за поиск истины. Глобальные фантазии. Внутренняя и внешняя предвзятость. Односторонние выводы."],
["Герпес","gerps","Герпес на губах. Пузырьковый лишай.\nОшибки:\nСильнейшее желание делать всё плохо. Сдержанная невысказанная горечь. Гнев, повисший на губах. Терзают гневные слова и боязнь их произнести. Осуждение человека противоположного пола, распространение этого суждения на всех представителей этого пола. Критическое отношение к противоположному полу. Целоваться и проявлять чувственность - недопустимо в социуме. Самонаказание за чувственность, за желания, которые \"нельзя\". Снижение способности человека четко выбирать и отстаивать свою позицию, желания, цели, ценности, отделять \"свое\" от \"чужого\". Затянувшийся процесс выбора в области партнерских отношений.\nПричиной герпеса в области губ и носа также становится регулярное напряжение мышц этой области в моменты усердия, сосредоточия, психологических реакций (сжатие губ, губы трубочкой, закусывание или поджимание губ и тп). В этом случае психосоматическую причину герпеса следует искать в причине напряжения носогубных мышц."],
["Гиперактивность","gipak","Гиперактивность. Гиперфункция.\nДети до 12 лет не имеют собственной причины болеть. Они принимают на себя болезни окружающих любимых людей.\nДо 5 лет ребенок трансформирует проблемы мамы. До 12 лет - мамы и папы. Даже если родители не живут вместе.\nДля выздоровления ребенка нужно изменять мышление его близких. Поэтому примеры мыслей при болезнях детей относятся к их родителям и семье.\nОшибки:\nСтрах. Огромное давление и лихорадочное состояние. Вы неистовствуете."],
["Гипервентиляция","gipvt","Гипервентиляция легких. Интенсивное дыхание, которое превышает потребности организма в кислороде.\nОшибки:\nСтрах. Сопротивление переменам. Недоверие к процессу перемен.\nНовая мысль:\nМне безопасно находиться в любом месте Вселенной. Я люблю себя и доверяю процессу жизни."],
["Гипертензия","giptn","Гипертензия. Гипертония. Повышенное кровяное давление.\nОшибки:\nДолгосуществующая неразрешимая эмоциональная проблема. Эмоции наружу. Повышенная чувствительность. Постоянное переживание одних и тех же ситуаций, старых незаживших эмоциональных травм. Привычка оценивать других и находить их ошибки. Склонность драматизировать ситуацию. Желание, чтобы все окружающие были счастливы. \"Поднимает слишком большой вес\". Переусердствует для всеобщего блага. Гиперответственность."],
["Гипертериоз","giptz","Гипертиреоз, тиреотоксикоз: Синдром, обусловленный повышением активности щитовидной железы.\nОшибки:\nГнев за игнорирование вашей личности. Крайнее разочарование в неспособности делать то, что хочется, реализация других, за счёт себя — некий извращённый жертво-мазохизм, заставляющий страдать других. А также ярость, что остались «за бортом». Чем ядовитее и злее мысли и слова, тем тяжелее протекание.\nНовая мысль:\nЯ нахожусь в центре жизни, я одобряю и себя, и всё, что вижу вокруг.\nПодробнее о новых мыслях в разделе \"Щитовидная железа\" 👇"],
["Гипогликемия","gipog","Гипогликемия. Пониженное содержание глюкозы в крови.\nОшибки:\nПодавленность тяготами жизни. \"Кому это надо?\"\nНовая мысль:\nЯ выбираю делать свою жизнь светлой, легкой и радостной."],
["Гипотензия","gipotz","Гипотензия. Гипотония. Пониженное артериальное давление.\nОшибки:\nДефицит любви в детстве. Уныние, слабость духа. Больше нет сил. Не могу это сделать. Сдаюсь. Пораженческое настроение. Трудности с принятием собственной ответственности за события, с жизненным творчеством. Обременен чужой проблемой. Большое внимание к плохим мыслям и сомнениям. Какая польза от всего этого, все равно ничего не получится?! Чувство вины. Эмоции в себе."],
["Гипотериоз","gipotr","Гипотиреоз. Синдром, обусловленный понижением активности щитовидной железы.\nОшибки:\nОпускаются руки. Уступчивость, отказ. Чувство безнадёжности, застоя, подавленности. Возникновение комплекса неполноценности. Часто сопровождается страхом перед недовольной сверхтребовательностью, собственной или близкого человека. Претензия к себе.\nНовая мысль:\nЯ строю новую жизнь по правилам, которые полностью удовлетворяют меня. Я могу и хочу действовать в этом мире. Мои стремления священны.\nПодробнее о новых мыслях в разделе \"Щитовидная железа\" 👇"],
["Гипофиз","gipof","Гипофиз. Является центральным органом эндокринной системы. Вырабатывает гормоны, влияющие на рост, обмен веществ и репродуктивную функцию.\nОлицетворяет центр контроля, управления.\nОшибки:\nОпухоль. Отсутствие ментального равновесия. Перепроизводство уничтожающих, подавляющих идей. Чувство перенасыщения силой.\nНовая мысль:\nМой ум и тело в равновесии. Я контролирую свои мысли, сознание.\nОпухоль. Я с любовью уравновешиваю мой ум и мое тело. Сейчас я выбираю мысли, от которых чувствую себя хорошо."],
["Гирсутизм","girsut","Гирсутизм. Избыточное оволосение у женщин и детей.\nОшибки:\nСкрытый гнев. Обычно используемое прикрытие — страх. Стремление обвинять. Часто: нежелание заниматься самовоспитанием."],
["Глаза","glaza","Глаза.\nОлицетворяют способность ясно видеть прошлое, настоящее и будущее.\nОшибки:\nНе нравится то, что вы видите собственными глазами.\nБлизорукость. Миопия. Страх будущего. Иногда - того будущего, что наступает в следующую секунду. Страх смотреть вперед, вдаль. Недоверие к тому, что ждет впереди. Неумение видеть перспективу. Жалость к матери и женщинам вообще.\nДальнозоркость. Страх жить настоящим. Готовы волноваться отдаленным временным и географическим проблемам, прошлому, будущему, но не настоящему. Не нравится, не готовы видеть, что происходит у себя под носом. Ощущение себя не от мира сего. Изменение с возрастом мышления на стратегическое. Невнимание к мелким деталям. Взгляд на жизнь со стороны. Желание получить много и сразу. Жалость к отцу и мужчинам в целом. Женщины - нежелание видеть то, что отражает зеркало.\nДальтонизм. Отказ от восприятия разнообразия, альтернатив, потенциалов, радости. Происходит вытеснение цветов, имеющих психологически травматичное значение - чаще всего, красного - обозначающего агрессию и/или вину.\nУ детей. Нежелание видеть, что происходит в семье. Стыдливость.\nГноящиеся глаза. Обиженность на принуждение (желание, чтобы меня не принуждали, желание жить вольной жизнью).\nСухие глаза. Гневные, злые глаза. Нежелание смотреть с любовью. Скорее умер бы, чем простил. Иногда злорадный, недоброжелательный, язвительный.\nПотеря зрения в старости. Нежелание видеть раздражающие мелочи жизни.\nПаралич глазных мышц. Страдания матери и женского пола."],
["Гланды","gland","Гланды. Миндалины.\nБиологический смысл - улучшить смачивание слюной «желаемого куска», чтобы быстрее его переварить.\nОшибки:\nСимволизируют «сдерживание». Что-то может начаться без вашего участия и желания. Боль - \"не получу желаемого, не будет счастья\". Убегание от боли. Страстное желание что-то иметь, что спасет от боли.\nТонзиллит. Воспаление миндалин. Страх. Подавленные эмоции. Задушенное творчество. Гордыня.\nсм. \"Ангина\" - острый тонзиллит.\nНовая мысль:\nУ меня есть все, что нужно в этот момент жизни. Я выбираю быть счастливым вне зависимости от получения \"лакомых кусков\". Желаемого я достигаю спокойно и планомерно.\nТонзиллит. Все хорошее течет во мне свободно. Я свободно выражаю себя. В моей душе царит мир."],
["Глаукома","glauk","Глаукома. Помутнение. Бельмо.\nОшибки:\nБоль. Упорнейшее нежелание простить.  Отказ посмотреть на то, как жил в прошлом. Давление от давно прошедшей боли, ран, обид. Переполнены и подавлены всем этим. Страдание в настоящем по поводу прошлого. Печаль."],
["Глухота","gluh","Глухота.\nОшибки:\nНеприятие, отрицание, упрямство, изоляция. Что вы не хотите слышать? Не беспокойте меня. Неумение и нежелание слушать других. Во время разговора мысли только о том, что собираетесь сказать сами. Все время кажется, что в чем-то обвиняют. Всегда оборонительная позиция. Очень тяжело выслушивать критику, даже если она конструктивна. Не прислушиваетесь к советам других людей и все время поступаете по-своему. Страх кого-то ослушаться, нарушить какие-то приказы или правила.\nНе даете себе права отклониться от чего-либо хотя бы на шаг. Высокая чувствительность и нежелание слышать о проблемах других людей из-за страха почувствовать себя обязанным решать эти проблемы, потерять время, которое могли бы потратить на себя.\nГлухонемота. Непослушание — протест против приказов родителей."],
["Голень","golen","Голень.\nГолень олицетворяет стандарты, устои жизни, жизненные принципы. Отношение к будущему и способности двигаться вперед.\nОшибки:\nРазрушение идеалов. Конфликт двух порывов - желанию мешают жизненные принципы. Страх столкновения с чем-то новым. Страх действий для достижения поставленной цели.\nБоль в состоянии покоя сигнализирует о том, что человек не дает себе возможности остановиться и подготовиться к движению в новом направлении."],
["Голеностоп","glnst","Голеностопный сустав.\nОшибки:\nОтсутствие гибкости и чувство вины. Желание бахвалиться своими достижениями. Лодыжки — символ способности к наслаждению.\nНовая мысль:\nЯ заслуживаю наслаждения жизнью. Я принимаю все радости, которые предлагает мне жизнь."],
["Головокружение","golokr","Головокружение.\nОшибки:\nБегство. Бессвязное, рассеянное, мимолетное, беспорядочное мышление. Отказ видеть, смотреть вокруг себя.\nНовая мысль:\nЯ концентрируюсь на жизни и нахожусь с ней в мире. Для меня безопасно жить и радоваться жизни."],
["Голод","golod","Повышенное чувство голода.\nОшибки:\nУжас без надежды на перемены. Неистовое желание очистить себя от чувства ненависти к себе.\nНовая мысль:\nЯ с радостью впускаю в жизнь перемены. Жить — прекрасно. Я люблю и принимаю себя."],
["Гонорея","gonor","Гонорея. Триппер.\nОшибки:\nПотребность в наказании. Плохой/плохая.\nНовая мысль:\nМоя сексуальность совершенна. Я люблю мою сексуальность. Я люблю и одобряю себя."],
["Горло","gorlo","Горло.\nСредство выражения, экспрессивности. Канал творчества. Способность принимать решения для удовлетворения своих потребностей, строить свою жизнь в соответствии со своими желаниями и развивать свою индивидуальность.\nОшибки:\nНеспособность постоять за себя. Проглоченный гнев. Удерживание гневных слов. Чувство неспособности выразить себя. Нерешительность в стремлении «Встать и идти». Сдерживание себя. Кризис творчества. Нежелание измениться.\nКом в горле. Ларингозпазм. Страх. Недоверие к процессу жизни. Ярость. Противостояние.\nПроблемы у детей. Ссоры между родителями, сопровождаемые криками.\nЛарингозпазм у детей. Вина за совершенный поступок, когда ребенка душит злоба."],
["Грибок","gribk","Грибок. Микоз.\nОшибки:\nЗастойные убеждения. Отказ высвободить прошлое. Позволение прошлому править сегодня. Желание избавиться от собственного стыда.\nКандидоз. Молочница. Разновидность грибковой инфекции, вызываемая микроскопическими грибами рода Candida.\nОшибки:\nОтрицание собственных потребностей. Отказ себе в поддержке.\nКандидоз.\nЧувство разбросанности. Сильные разочарования и гнев. Претензии и недоверие к людям.\nМолочница.\nПережитый или подавленный гнев. Жалость по \"утраченной\" душевной чистоте, стыд и тоска о непорочности. Желание, чтобы окружающие верили в Вашу невинность, непорочность. Вера в существование «правильных» и «ошибочных решений», высокая значимость чужой оценки и самонаказание за несоответствие. Злость за принятие ошибочных решений. Тоска по себе «идеальной». Согласились на секс, не хотя. Близость с мужчиной не оправдала ожидания, но вы не прервали процесс. Мужчина нарушил личные границы.\nГрибок стопы.\nБезысходность от того, что тебя не признают. Неспособность к лёгкому продвижению вперёд. Желание избавиться (страх не избавиться) от ограничивающих свободу, цепляющихся людей, от постыдного бремени."],
["Грипп","gripp","Эпидемии. Пандемии. Грипп.\nОшибки:\nУдручённость, недовольство собой. Ответ на негативность и убеждения масс, групп людей. Реакция не негативный настрой окружения, общепринятые отрицательные установки. Страх. Вера в статистические данные.\nНовая мысль:\nЯ вне групповых убеждений или календаря. Я свободен/свободна от внешнего воздействия, скученности, истерии и влияния людей."],
["Груди","grud","Груди.\nСимволизируют материнскую заботу, уход, воспитание, вынашивание, вскармливание.\nОшибки:\nОтказ себе в «питании». Ставите себя на последнее место. Нелюбовь к себе. Нелестные мысли о себе, как женщине.\nКиста, уплотнения, мастит, опухоль, язвы. Позиция подавления. Чрезмерная забота и уход за кем-то. Чрезмерная протекция, защита кого-то. Прерывание питания. Обида на себя или на своего полового партнера. Обвинение другого в том, что он не любит. Гордыня, пробивание себе дороги ценой любых усилий."],
["Грыжа","grzh","Грыжа.\nОшибки:\nНапряжение, отягощенность, нагрузка, груз, бремя. Неверное творческое выражение.\nПаховая грыжа.\nДлительное отсутствие половых отношений между партнерами. Прерванные отношения. Нереальное желание, вызвавшее злобу своей неисполнимостью.\nГрыжа диафрагмы.\nЖелание единым рывком перенестись из прошлого в будущее.\nГрыжа пищевого отверстия диафрагмы.\nЖелание пробиться в общество, туда, где человека не ждут."],
["Грыжа межпозвоночная","grmp","Грыжа межпозвоночного диска.\nОшибки:\nОщущение, что жизнь полностью лишила вас поддержки. Загнан в угол. Склонность скорее сломаться, чем сдаться. Не может больше выносить, но не способен от этого отказаться. Нежелание \"отпускать\", \"просить о помощи\" и \"сдаваться\" при каком-то огромном напряжении. Кроме работы ничего не замечает. Заболевание трудоголиков. Желание резко разорвать ситуацию, но останавливает страх материального неблагополучия."],
["Губы","guby","Губы.\nСимволизируют чувственность,  которую мы разрешаем себе демонстрировать в социуме. Ношение усов - подсознательная попытка скрыть чувственность.\nВерхняя губа - желания, которые мы носим в себе.\nНижняя губа - среда, в которой мы развиваемся.\nОшибки:\nТрещины. Противоречие чувств, демонстрируемых в социуме. \"И туда хочется, и сюда\". Невозможность \"разорваться\".\nКусание губ. Самонаказание за проявленную чувственность. Сказал что-то лишнее, проговорился."],
